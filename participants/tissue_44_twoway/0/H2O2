FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      H2O2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Absolute H2O2 concentration [mol/m3].
// Shared exposure: 100 uM = 0.1 mol/m3.

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 0.1;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 0;
    }
    walls
    {
        type            fixedValue;
        value           uniform 0;
    }
}


