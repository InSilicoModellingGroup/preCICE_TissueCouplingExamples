<?xml version="1.0" encoding="UTF-8"?>
<precice-configuration experimental="true"
    xmlns:data="http://www.precice.org/schema/data"
    xmlns:m2n="http://www.precice.org/schema/m2n"
    xmlns:mapping="http://www.precice.org/schema/mapping"
    xmlns:export="http://www.precice.org/schema/export"
    xmlns:acceleration="http://www.precice.org/schema/acceleration"
    xmlns:coupling-scheme="http://www.precice.org/schema/coupling-scheme">
  <log>
    <sink filter="%Severity% >= debug and %Rank% = 0"
      format="---[precice] %ColorizedSeverity% %Message%" enabled="true"/>
  </log>
  <!-- H2O2 and NO2- transport; both cellular sinks are returned in case 4.4. -->
  <data:scalar name="H2O2"/>
  <data:scalar name="NO2"/>
  <data:scalar name="H2O2Sink"/>
  <data:scalar name="NO2Sink"/>
  <data:vector name="WallGeometry"/>
  <data:vector name="WallNormals"/>
  <data:scalar name="WallAreas"/>
  <data:vector name="BoundaryTriangleVertex0"/>
  <data:vector name="BoundaryTriangleVertex1"/>
  <data:vector name="BoundaryTriangleVertex2"/>
  <data:scalar name="BoundaryKind"/>
  <data:vector name="BoundaryNormals"/>
  <data:vector name="BoundaryVelocity"/>
  <mesh name="FVMmesh" dimensions="3">
    <use-data name="H2O2"/><use-data name="NO2"/>
    <use-data name="H2O2Sink"/><use-data name="NO2Sink"/>
  </mesh>
  <mesh name="WallSurfaceMesh" dimensions="3">
    <use-data name="WallGeometry"/><use-data name="WallNormals"/><use-data name="WallAreas"/>
  </mesh>
  <mesh name="BoundaryTriangleMesh" dimensions="3">
    <use-data name="BoundaryTriangleVertex0"/><use-data name="BoundaryTriangleVertex1"/>
    <use-data name="BoundaryTriangleVertex2"/><use-data name="BoundaryKind"/>
    <use-data name="BoundaryNormals"/><use-data name="BoundaryVelocity"/>
  </mesh>
  <mesh name="ABMmesh" dimensions="3"><use-data name="H2O2"/><use-data name="NO2"/></mesh>
  <participant name="FVM">
    <provide-mesh name="FVMmesh"/>
    <provide-mesh name="WallSurfaceMesh"/>
    <provide-mesh name="BoundaryTriangleMesh"/>
    <write-data name="H2O2" mesh="FVMmesh"/>
    <write-data name="NO2" mesh="FVMmesh"/>
    <write-data name="WallGeometry" mesh="WallSurfaceMesh"/>
    <write-data name="WallNormals" mesh="WallSurfaceMesh"/>
    <write-data name="WallAreas" mesh="WallSurfaceMesh"/>
    <write-data name="BoundaryTriangleVertex0" mesh="BoundaryTriangleMesh"/>
    <write-data name="BoundaryTriangleVertex1" mesh="BoundaryTriangleMesh"/>
    <write-data name="BoundaryTriangleVertex2" mesh="BoundaryTriangleMesh"/>
    <write-data name="BoundaryKind" mesh="BoundaryTriangleMesh"/>
    <write-data name="BoundaryNormals" mesh="BoundaryTriangleMesh"/>
    <write-data name="BoundaryVelocity" mesh="BoundaryTriangleMesh"/>
    <read-data name="H2O2Sink" mesh="FVMmesh"/>
    <read-data name="NO2Sink" mesh="FVMmesh"/>
  </participant>
  <participant name="cells">
    <provide-mesh name="ABMmesh"/>
    <receive-mesh name="FVMmesh" from="FVM" api-access="true"/>
    <receive-mesh name="WallSurfaceMesh" from="FVM" api-access="true"/>
    <receive-mesh name="BoundaryTriangleMesh" from="FVM" api-access="true"/>
    <read-data name="H2O2" mesh="FVMmesh"/>
    <read-data name="NO2" mesh="FVMmesh"/>
    <read-data name="WallGeometry" mesh="WallSurfaceMesh"/>
    <read-data name="WallNormals" mesh="WallSurfaceMesh"/>
    <read-data name="WallAreas" mesh="WallSurfaceMesh"/>
    <read-data name="BoundaryTriangleVertex0" mesh="BoundaryTriangleMesh"/>
    <read-data name="BoundaryTriangleVertex1" mesh="BoundaryTriangleMesh"/>
    <read-data name="BoundaryTriangleVertex2" mesh="BoundaryTriangleMesh"/>
    <read-data name="BoundaryKind" mesh="BoundaryTriangleMesh"/>
    <read-data name="BoundaryNormals" mesh="BoundaryTriangleMesh"/>
    <read-data name="BoundaryVelocity" mesh="BoundaryTriangleMesh"/>
    <write-data name="H2O2Sink" mesh="FVMmesh"/>
    <write-data name="NO2Sink" mesh="FVMmesh"/>
    <mapping:nearest-neighbor direction="read" from="FVMmesh" constraint="consistent"/>
  </participant>
  <m2n:sockets acceptor="FVM" connector="cells" exchange-directory="EXCHANGE_DIR"/>
  <coupling-scheme:serial-implicit>
    <time-window-size value="0.1"/>
    <max-time value="900.0"/>
    <participants first="FVM" second="cells"/>
    <max-iterations value="15"/>
    <exchange data="H2O2" mesh="FVMmesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="NO2" mesh="FVMmesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="WallGeometry" mesh="WallSurfaceMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="WallNormals" mesh="WallSurfaceMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="WallAreas" mesh="WallSurfaceMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="BoundaryTriangleVertex0" mesh="BoundaryTriangleMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="BoundaryTriangleVertex1" mesh="BoundaryTriangleMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="BoundaryTriangleVertex2" mesh="BoundaryTriangleMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="BoundaryKind" mesh="BoundaryTriangleMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="BoundaryNormals" mesh="BoundaryTriangleMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="BoundaryVelocity" mesh="BoundaryTriangleMesh" from="FVM" to="cells" initialize="true"/>
    <exchange data="H2O2Sink" mesh="FVMmesh" from="cells" to="FVM" initialize="false"/>
    <exchange data="NO2Sink" mesh="FVMmesh" from="cells" to="FVM" initialize="false"/>
    <relative-convergence-measure data="H2O2" mesh="FVMmesh" limit="1e-05"/>
    <relative-convergence-measure data="NO2" mesh="FVMmesh" limit="1e-05"/>
    <relative-convergence-measure data="H2O2Sink" mesh="FVMmesh" limit="1e-04"/>
    <relative-convergence-measure data="NO2Sink" mesh="FVMmesh" limit="1e-04"/>
  </coupling-scheme:serial-implicit>
</precice-configuration>
