FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      H2O2;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Absolute H2O2 [uM]. Treated face = cylinder top.

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    top
    {
        type            fixedValue;
        value           uniform 92.399465444;
    }
    bottom
    {
        type            fixedValue;
        value           uniform 0;
    }
    walls
    {
        type            fixedValue;
        value           uniform 0;
    }
}


